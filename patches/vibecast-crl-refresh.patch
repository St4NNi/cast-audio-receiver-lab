+        let refreshed = resolve_crl(&http, initial, &url).await;
+        assert_eq!(refreshed.as_deref(), Some(b"refreshed".as_slice()));
+        let retained = resolve_crl(&http, refreshed.clone(), &url).await;
+        assert_eq!(retained, refreshed);
+        server.await.unwrap();
+    }
